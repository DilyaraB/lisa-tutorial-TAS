class extendedSigns {
    testAddition() {
        def a = -5;  // NEGATIVE
        def b = 5;   // POSITIVE
        def c = 0;   // ZERO
        def d = -1;  // NEGATIVE
        def e = 1;   // POSITIVE

        // NEGATIVE + NEGATIVE = NEGATIVE
        def sum1 = a + d;  // (-5) + (-1) = -6 -> NEGATIVE

        // POSITIVE + POSITIVE = POSITIVE
        def sum2 = b + e;  // 5 + 1 = 6 -> POSITIVE

        // NEGATIVE + POSITIVE = TOP
        def sum3 = a + b;  // (-5) + 5 = 0, mais abstraction -> TOP (car signe ambigu)
        
        // POSITIVE + NEGATIVE = TOP
        def sum4 = b + d;  // 5 + (-1) = 4, mais abstraction -> TOP (car signe ambigu)

        // ZERO + POSITIVE = POSITIVE
        def sum5 = c + b;  // 0 + 5 = 5 -> POSITIVE

        // ZERO + NEGATIVE = NEGATIVE
        def sum6 = c + a;  // 0 + (-5) = -5 -> NEGATIVE

        // NEGATIVE + ZERO = NEGATIVE
        def sum7 = d + c;  // (-1) + 0 = -1 -> NEGATIVE

        // POSITIVE + ZERO = POSITIVE
        def sum8 = e + c;  // 1 + 0 = 1 -> POSITIVE
    }

    testSubtraction() {
        def a = -5;  // NEGATIVE
        def b = 5;   // POSITIVE
        def c = 0;   // ZERO
        def d = -1;  // NEGATIVE
        def e = 1;   // POSITIVE

        // NEGATIVE - POSITIVE = NEGATIVE
        def sub1 = a - b;  // (-5) - 5 = -10 -> NEGATIVE

        // POSITIVE - NEGATIVE = POSITIVE
        def sub2 = b - a;  // 5 - (-5) = 10 -> POSITIVE

        // ZERO - NEGATIVE = POSITIVE
        def sub3 = c - a;  // 0 - (-5) = 5 -> POSITIVE

        // ZERO - POSITIVE = NEGATIVE
        def sub4 = c - b;  // 0 - 5 = -5 -> NEGATIVE

        // NEGATIVE - NEGATIVE = TOP
        def sub5 = a - d;  // (-5) - (-1) = -4, mais abstraction -> TOP (car signe ambigu)
        
        // POSITIVE - POSITIVE = TOP
        def sub6 = b - e;  // 5 - 1 = 4, mais abstraction -> TOP (car signe ambigu)

        // POSITIVE - ZERO = POSITIVE
        def sub7 = e - c;  // 1 - 0 = 1 -> POSITIVE

        // NEGATIVE - ZERO = NEGATIVE
        def sub8 = d - c;  // (-1) - 0 = -1 -> NEGATIVE
    }

    testMultiplication() {
        def a = -5;  // NEGATIVE
        def b = 5;   // POSITIVE
        def c = 0;   // ZERO
        def d = -1;  // NEGATIVE
        def e = 1;   // POSITIVE

        // POSITIVE * POSITIVE = POSITIVE
        def mul1 = b * e;  // 5 * 1 = 5 -> POSITIVE

        // NEGATIVE * NEGATIVE = POSITIVE
        def mul2 = a * d;  // (-5) * (-1) = 5 -> POSITIVE

        // POSITIVE * NEGATIVE = NEGATIVE
        def mul3 = b * a;  // 5 * (-5) = -25 -> NEGATIVE
        
        // NEGATIVE * POSITIVE = NEGATIVE
        def mul4 = a * b;  // (-5) * 5 = -25 -> NEGATIVE
        
        // ZERO * POSITIVE = ZERO
        def mul5 = c * b;  // 0 * 5 = 0 -> ZERO

        // ZERO * NEGATIVE = ZERO
        def mul6 = c * d;  // 0 * (-1) = 0 -> ZERO

        // POSITIVE * ZERO = ZERO
        def mul7 = e * c;  // 1 * 0 = 0 -> ZERO
        
        // NEGATIVE * ZERO = ZERO
        def mul8 = a * c;  // (-5) * 0 = 0 -> ZERO
    }

    testDivision() {
        def a = -5;  // NEGATIVE
        def b = 5;   // POSITIVE
        def c = 0;   // ZERO
        def d = -1;  // NEGATIVE
        def e = 1;   // POSITIVE

        // POSITIVE / POSITIVE = POSITIVE
        def div1 = b / e;  // 5 / 1 = 5 -> POSITIVE

        // NEGATIVE / NEGATIVE = POSITIVE
        def div2 = a / d;  // (-5) / (-1) = 5 -> POSITIVE

        // NEGATIVE / POSITIVE = NEGATIVE
        def div3 = a / b;  // (-5) / 5 = -1 -> NEGATIVE

        // POSITIVE / NEGATIVE = NEGATIVE
        def div4 = b / a;  // 5 / (-5) = -1 -> NEGATIVE

        // ZERO / POSITIVE = ZERO
        def div5 = c / b;  // 0 / 5 = 0 -> ZERO
        
        // ZERO / NEGATIVE = ZERO
        def div6 = c / d;  // 0 / (-1) = 0 -> ZERO

        // NEGATIVE / ZERO = BOTTOM
        def div7 = a / c;  // (-5) / 0 -> BOTTOM
        
        // POSITIVE / ZERO = BOTTOM
        def div8 = b / c;  // 5 / 0 -> BOTTOM
    }
    
    testGreaterOrLessThanZero(a, b) {
    	def x = 0;
    	def y = 0;
    	if (a > b)
    		x = 1;  // >=ZERO
    	else
    		y = -1; // <=ZERO
        
        def i = x+y; // >=ZERO + <=ZERO -> TOP
        def j = y+x; // <=ZERO + >=ZERO -> TOP
        def k = x-y; // >=ZERO - <=ZERO -> >=ZERO
        def l = y-x; // <=ZERO - >=ZERO -> <=ZERO
        def m = x*y; // >=ZERO * <=ZERO -> <=ZERO
        def n = x/y; // >=ZERO / <=ZERO -> BOTTOM
    }

    loop() {
        def x = 0;  // ZERO
        def a = 5;  // POSITIVE
        while (x < a) {  // x < 5 : x commence à ZERO, puis augmente
            x = x + 1;  // x devient POSITIVE, POSITIVE < POSITIVE -> TOP
        }  // A la sortie : x >= 5 -> POSITIVE
    }

    conditional() {
        def i = -1;  // NEGATIVE
        def j = 1;   // POSITIVE

        if (i > 1) {  // NEGATIVE > POSITIVE = NOT_SATISFIED, branche non prise -> BOTTOM
            i = 1;    // POSITIVE (non exécuté)
            j = 2;    // POSITIVE (non exécuté)
        } // i reste NEGATIVE, j reste POSITIVE

        if (i < 1) {  // NEGATIVE < POSITIVE = SATISFIED, branche prise
            i = i + 1;  // NEGATIVE + POSITIVE = TOP
            j = j + 2;  // POSITIVE + POSITIVE = POSITIVE
        } // Après exécution : i = TOP, j = POSITIVE
    }
    
    branche1(a, b) {
        def x = 0;  // ZERO
        if (a > b)  // Dépend des valeurs de a et b
            x = x * 7;  // ZERO * POSITIVE = ZERO
        else
            x = -7;  // NEGATIVE
        def y = x / x;  // x = ZERO ou x = NEGATIVE -> <=ZERO
        				// y = <=ZERO / <=ZERO -> BOTTOM
    }
    
    branche2(a, b) {
        def x = 7;  // POSITIVE
        if (a > b)  // Dépend des valeurs de a et b
            x = x * 7;  // POSITIVE * POSITIVE = POSITIVE
        else
            x = -7;  // NEGATIVE
        def y = x / x;  // x = POSITIVE ou x = NEGATIVE -> TOP
        				// Donc y = x / x = TOP / TOP -> TOP
    }
}