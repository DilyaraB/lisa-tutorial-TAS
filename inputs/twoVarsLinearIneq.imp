class twoVarsLinearIneq {

    // Test basic inequalities with assignments and comparisons
    basic(x) {
        def y = x + 1;
        def z = y + 2;
        if (x <= z) {
            def w = z;
        }
    }

    testClosure(x) {
        def y = x + 2;
        if (y <= x + 1) {
            def z = y;
            if (z <= x) {
                def w = z;
            }
        }
    }

    // Test more complex relationships and projection
    /*complex(a) {
