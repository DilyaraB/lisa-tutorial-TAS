            c = a + 2;    // Overwrites c, new constraints: c - a <= 2, a - c <= -2
        }
        def d = c + 1;    // d - c <= 1, c - d <= -1
    }

    // Test unsatisfiability
    unsat(x) {
        def y = x + 1;    // x - y <= -1, y - x <= 1
        if (x >= y) {     // -x + y <= 0 (contradicts y = x + 1)
            def z = x;    // Should reach bottom state
        }
    }*/
}